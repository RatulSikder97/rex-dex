<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- V8 JIT (Electron renderer + the bundled engine run with ELECTRON_RUN_AS_NODE). -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Native Node addons (better-sqlite3, node-pty, resvg) and plugin binaries. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Agent CLIs launched from REX may rely on DYLD_* from the user's shell. -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <key>com.apple.security.automation.apple-events</key>
    <true/>
  </dict>
</plist>
