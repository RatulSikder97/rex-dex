{
  "name": "rex",
  "version": "0.1.0",
  "private": true,
  "description": "REX — one-person company operating system: plan, build, ship, market with AI departments.",
  "scripts": {
    "dev": "next dev -p 4747",
    "build": "next build",
    "start": "next start -p 4747",
    "desktop:dev": "node desktop/scripts/dev.mjs",
    "desktop:stage": "node desktop/scripts/stage.mjs",
    "desktop:icons": "node desktop/scripts/icons.mjs",
    "desktop:build": "node desktop/scripts/build.mjs",
    "desktop:build:dir": "node desktop/scripts/build.mjs --dir",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "postinstall": "node -e \"const fs=require('fs'),p=require('path');const d='node_modules/node-pty/prebuilds';if(fs.existsSync(d))for(const x of fs.readdirSync(d)){const f=p.join(d,x,'spawn-helper');if(fs.existsSync(f))fs.chmodSync(f,0o755)}\""
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@resvg/resvg-js": "^2.6.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "lucide-react": "^1.68.0",
    "next": "^16.4.5",
    "node-pty": "^1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3"
  },
  "bin": {
    "rex": "bin/rex.mjs"
  }
}
